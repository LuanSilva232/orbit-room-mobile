{
  "name": "orbit-room-mobile-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "node dist/migrate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.14",
    "better-auth": "^1.7.14",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
